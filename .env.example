# Copy these into your shell environment before starting Uvicorn.
# Never commit real passwords or API credentials.
APP_BASE_URL=http://127.0.0.1:8000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@example.com
# Optional: without these, Rocket uses the no-key fallback image provider.
IMAGE_API_URL=https://api.openai.com/v1/images/generations
IMAGE_API_KEY=your-image-provider-api-key
IMAGE_MODEL=dall-e-3
